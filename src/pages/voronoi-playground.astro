---
import Layout from '../layouts/Layout.astro';
import VoronoiMosaicDemo from '../components/VoronoiMosaicDemo.astro';
import SamMosaicDemo from '../components/SamMosaicDemo.astro';
---
<Layout title="Voronoi Playground" description="Interactive adaptive-sampling Voronoi mosaic demo.">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Voronoi Mosaic</p>
      <h1>Interactive Demo</h1>
      <p class="lede">
        Two interfaces on one page. <strong>Adaptive Sampling</strong> turns a whole image into a
        Voronoi mosaic; <strong>Segment Anything (SAM)</strong> mosaics only a segmented object.
        Switch between them with the toggle below.
      </p>

      <div class="demo-tabs" role="tablist" aria-label="Choose a demo">
        <button type="button" class="demo-tab is-active" id="tab-adaptive" data-panel="panel-adaptive" role="tab" aria-selected="true">Adaptive Sampling</button>
        <button type="button" class="demo-tab" id="tab-sam" data-panel="panel-sam" role="tab" aria-selected="false">Segment Anything (SAM)</button>
      </div>

      <div id="panel-adaptive" role="tabpanel">
        <VoronoiMosaicDemo />
      </div>
      <div id="panel-sam" role="tabpanel" hidden>
        <SamMosaicDemo />
      </div>

      <p class="note">
        Demonstration of the usage of linearized-luminance + Sobel density,
        density-weighted sampling, a grid-accelerated nearest-seed partition, and Lloyd relaxation in Mosaic art.
      </p>
    </div>
  </section>
</Layout>

<script>
  const tabs = Array.from(document.querySelectorAll('.demo-tab'));
  let samActivated = false;
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      document.getElementById('panel-adaptive').hidden = tab.dataset.panel !== 'panel-adaptive';
      document.getElementById('panel-sam').hidden = tab.dataset.panel !== 'panel-sam';
      if (tab.dataset.panel === 'panel-sam' && !samActivated) {
        samActivated = true;
        window.dispatchEvent(new Event('sam:activate'));
      }
    });
  });
</script>

<style>
  .narrow { max-width: 820px; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 0.4rem;
  }
  h1 { margin-bottom: 0.75rem; }
  .lede { color: var(--text); line-height: 1.75; margin-bottom: 0.75rem; }
  .note { font-size: 0.8rem; color: var(--muted); line-height: 1.7; margin-top: 0.5rem; }

  .demo-tabs {
    display: inline-flex; border: 1px solid var(--border-2); border-radius: 6px;
    overflow: hidden; margin: 0.25rem 0 0.25rem;
  }
  .demo-tab {
    font-family: var(--font-mono); font-size: 0.78rem; cursor: pointer;
    padding: 0.5rem 1rem; background: var(--bg); color: var(--muted);
    border: 0; transition: background 0.15s, color 0.15s;
  }
  .demo-tab + .demo-tab { border-left: 1px solid var(--border-2); }
  .demo-tab:not(.is-active):hover { color: var(--accent); }
  .demo-tab.is-active { background: var(--accent); color: var(--bg); }
</style>
