---
import Layout from '../layouts/Layout.astro';
import { papers } from '../data/research';
const base = import.meta.env.BASE_URL;
---
<Layout title="Research">

  <section class="section-sm page-header">
    <div class="container">
      <p class="section-label">// exploration</p>
      <h1>Research</h1>
      <p class="header-desc">
        Active research growing from the Math+Code+Art initiative — investigating how far the underlying ideas can go.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 2rem; padding-bottom: 6rem">
    <div class="container">
      <div class="paper-list">
        {papers.map((p, i) => (
          <article class="paper-card">
            <div class="paper-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="paper-body">
              <div class="paper-top">
                <div class="paper-tags">
                  {p.tags.map(t => <span class="tag">{t}</span>)}
                </div>
                <span class="paper-venue">{p.venue} · {p.year}</span>
              </div>
              <h2 class="paper-title">{p.title}</h2>
              <p class="paper-subtitle">{p.subtitle}</p>
              <p class="paper-authors">{p.authors.join(', ')}</p>
              <p class="paper-desc">{p.description}</p>
              <div class="paper-links">
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="paper-link primary">
                  {p.linkLabel} →
                </a>
                <span class="paper-arxiv">{p.arxiv}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="connection-note">
        <p class="connection-label">// connection to tutorials</p>
        <p>
          Voronoi geometry runs through multiple tutorials — from Voronoi Photo Mosaic to Style Transfer Voronoi.
          Stroke-based rendering connects to the Music Painting and Neural Music Visualizer tutorials at a conceptual level.
          Together, these works show the depth reachable from the same interplay of mathematics, code, and art.
        </p>
        <a href={`${base}tutorials`} class="btn btn-ghost" style="margin-top: 1.25rem">Browse tutorials →</a>
      </div>
    </div>
  </section>

</Layout>

<style>
.page-header { border-bottom: 1px solid var(--border); padding-bottom: 2.5rem; }
.page-header h1 { margin-bottom: 0.75rem; }
.header-desc {
  font-size: 0.95rem;
  color: var(--muted);
  max-width: 560px;
  line-height: 1.75;
}

/* Paper list */
.paper-list { display: flex; flex-direction: column; gap: 0; }

.paper-card {
  display: grid;
  grid-template-columns: 3rem 1fr;
  gap: 1.5rem;
  padding: 2.5rem 0;
  border-bottom: 1px solid var(--border);
  align-items: start;
}
.paper-card:first-child { padding-top: 0; }

.paper-num {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--faint);
  letter-spacing: 0.06em;
  padding-top: 0.25rem;
}

.paper-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}
.paper-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
.paper-venue {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--muted);
  letter-spacing: 0.04em;
  flex-shrink: 0;
}

.paper-title {
  font-family: var(--font-mono);
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 0.3rem;
}
.paper-subtitle {
  font-size: 0.9rem;
  color: var(--accent);
  margin-bottom: 0.5rem;
  font-family: var(--font-body);
}
.paper-authors {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.02em;
  margin-bottom: 1rem;
  line-height: 1.6;
}
.paper-desc {
  font-size: 0.92rem;
  color: var(--muted);
  line-height: 1.8;
  max-width: 680px;
  margin-bottom: 1.25rem;
}

.paper-links {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}
.paper-link.primary {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--accent);
  transition: opacity 0.15s;
  letter-spacing: 0.02em;
}
.paper-link.primary:hover { opacity: 0.7; }
.paper-arxiv {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--muted);
  letter-spacing: 0.02em;
}

/* Connection note */
.connection-note {
  margin-top: 3.5rem;
  padding: 2rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  max-width: 680px;
}
.connection-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}
.connection-note > p {
  font-size: 0.9rem;
  line-height: 1.8;
  color: var(--muted);
}

@media (max-width: 560px) {
  .paper-card { grid-template-columns: 1fr; gap: 0.5rem; }
  .paper-num { display: none; }
}
</style>
