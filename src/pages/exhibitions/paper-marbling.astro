---
import Layout from '../../layouts/Layout.astro';
import { exhibitions } from '../../data/exhibitions';

const base = import.meta.env.BASE_URL;
const exh  = exhibitions.find(e => e.slug === 'paper-marbling')!;

function src(filename: string) {
  return `${base}exhibitions/paper-marbling/${filename}`;
}
---
<Layout title={exh.title} description={exh.subtitle}>

  <section class="section-sm page-header">
    <div class="container narrow">
      <a href={`${base}exhibitions`} class="back">← Exhibitions</a>
      <p class="kicker">Math + Code + Art Initiative · UCLA Mathematics · {exh.year}</p>
      <h1>{exh.title}</h1>
      <p class="subtitle">{exh.subtitle}</p>
      <p class="artists">{exh.artists.join(', ')}</p>
    </div>
  </section>

  <!-- Artist Statement -->
  <section class="section statement-section">
    <div class="container narrow">
      <p class="label">Exhibition Statement</p>
      <div class="statement">
        {exh.statement.map(para => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Works (populated when images are available) -->
  {exh.works.length > 0 && (
    <section class="section works-section">
      <div class="container narrow">
        <p class="label">Works</p>
        <div class="works-grid">
          {exh.works.map(work => (
            <div class="work-item img-box">
              <img src={src(work.src)} alt={work.title} loading="lazy" />
              <p class="work-caption">{work.title} · {work.year}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Placeholder when no images yet -->
  {exh.works.length === 0 && (
    <section class="section placeholder-section">
      <div class="container narrow">
        <div class="placeholder-box">
          <p class="placeholder-label">// works coming soon</p>
          <p>Exhibition images will appear here once uploaded to <code>public/exhibitions/paper-marbling/</code>.</p>
        </div>
      </div>
    </section>
  )}

  <!-- Medium note -->
  <section class="section medium-section">
    <div class="container narrow">
      <p class="label">Medium</p>
      <p class="medium-text">{exh.medium}</p>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" aria-hidden="true">
    <button id="lb-close" aria-label="Close">✕</button>
    <img id="lb-img" src="" alt="" />
  </div>

</Layout>

<style>
/* ── Exhibition Catalogue aesthetic — dark warm sepia ── */
:global(body) {
  background-color: #110e0a;
  background-image: none;
  color: #f0e8d8;
}
:global(.nav-wrap) {
  background: rgba(17,14,10,0.88) !important;
  border-bottom-color: #2a2218 !important;
}
:global(.nav-logo-text) { color: #f0e8d8 !important; }
:global(.nav-links a)   { color: #8a7a6a !important; }
:global(.nav-links a:hover) { color: #f0e8d8 !important; background: rgba(255,255,255,0.05) !important; border-color: #2a2218 !important; }
:global(.footer) { border-top-color: #2a2218 !important; background: #0d0b08 !important; }
:global(.footer-name, .footer-sub, .footer-links a) { color: #8a7a6a !important; }
:global(.footer-links a:hover) { color: #c9a96e !important; background: transparent !important; }

--cat-bg:     #110e0a;
--cat-ink:    #f0e8d8;
--cat-muted:  #8a7a6a;
--cat-border: #2a2218;
--cat-accent: #c9a96e;

.narrow { max-width: 820px; }

/* Header */
.page-header {
  border-bottom: 1px solid var(--cat-border);
  padding-bottom: 3rem;
}
.back {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cat-muted);
  margin-bottom: 1.75rem;
  transition: color 0.15s;
  letter-spacing: 0.03em;
}
.back:hover { color: var(--cat-ink); }
.kicker {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--cat-muted);
  margin-bottom: 1.1rem;
}
h1 {
  font-family: var(--font-serif) !important;
  font-size: clamp(2rem, 5vw, 3.2rem) !important;
  font-weight: 400 !important;
  letter-spacing: -0.01em !important;
  color: var(--cat-ink) !important;
  line-height: 1.15 !important;
  margin-bottom: 0.75rem;
}
.subtitle {
  font-size: 1.05rem;
  color: var(--cat-muted);
  font-style: italic;
  margin-bottom: 0.6rem;
}
.artists {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cat-muted);
  letter-spacing: 0.04em;
}

/* Labels */
.label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cat-muted);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--cat-border);
}

/* Statement */
.statement-section { padding-bottom: 0; }
.statement { display: flex; flex-direction: column; gap: 1.25rem; max-width: 640px; }
.statement p {
  font-size: 1rem;
  line-height: 1.9;
  color: var(--cat-ink);
  font-weight: 300;
}

/* Works grid */
.works-section { border-top: 1px solid var(--cat-border); }
.works-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1.5rem;
}
.work-item { display: flex; flex-direction: column; gap: 0.5rem; }
.img-box {
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 2px;
  border: 1px solid var(--cat-border);
  background: #1e1a14;
  cursor: zoom-in;
}
.img-box img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s var(--ease-out);
}
.img-box:hover img { transform: scale(1.03); }
.work-caption {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--cat-muted);
  letter-spacing: 0.04em;
}

/* Placeholder */
.placeholder-section { border-top: 1px solid var(--cat-border); padding-bottom: 0; }
.placeholder-box {
  background: #1a1510;
  border: 1px solid var(--cat-border);
  border-radius: 2px;
  padding: 2rem;
  max-width: 480px;
}
.placeholder-label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cat-accent);
  margin-bottom: 0.75rem;
}
.placeholder-box p {
  font-size: 0.88rem;
  color: var(--cat-muted);
  line-height: 1.7;
}
.placeholder-box code {
  font-family: var(--font-mono);
  font-size: 0.82em;
  background: rgba(0,0,0,0.06);
  padding: 0.1em 0.3em;
  border-radius: 2px;
}

/* Medium */
.medium-section { border-top: 1px solid var(--cat-border); padding-bottom: 5rem; }
.medium-text {
  font-size: 0.9rem;
  color: var(--cat-muted);
  font-style: italic;
  line-height: 1.7;
  max-width: 480px;
}

/* Lightbox */
#lightbox {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(10,8,5,0.92);
  display: flex; align-items: center; justify-content: center;
  padding: 2rem;
  opacity: 0; pointer-events: none;
  transition: opacity 0.2s ease;
}
#lightbox.open { opacity: 1; pointer-events: all; }
#lb-img {
  max-width: 100%; max-height: 90vh;
  object-fit: contain;
  border-radius: 2px;
  box-shadow: 0 8px 60px rgba(0,0,0,0.7);
  transform: scale(0.96);
  transition: transform 0.2s ease;
}
#lightbox.open #lb-img { transform: scale(1); }
#lb-close {
  position: absolute; top: 1.25rem; right: 1.5rem;
  background: none; border: none;
  color: rgba(255,255,255,0.5); font-size: 1.4rem;
  cursor: pointer; line-height: 1;
  transition: color 0.15s;
}
#lb-close:hover { color: #fff; }
</style>

<script>
const lb    = document.getElementById('lightbox')!;
const lbImg = document.getElementById('lb-img') as HTMLImageElement;

function openLightbox(src: string, alt: string) {
  lbImg.src = src; lbImg.alt = alt;
  lb.classList.add('open');
  lb.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  lb.classList.remove('open');
  lb.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

document.querySelectorAll<HTMLElement>('.img-box').forEach(box => {
  box.addEventListener('click', () => {
    const img = box.querySelector('img')!;
    if (img) openLightbox(img.src, img.alt);
  });
});

document.getElementById('lb-close')!.addEventListener('click', closeLightbox);
lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
