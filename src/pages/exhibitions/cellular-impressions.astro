---
import Layout from '../../layouts/Layout.astro';
import { exhibitions } from '../../data/exhibitions';
import { tutorials } from '../../data/tutorials';

const base = import.meta.env.BASE_URL;
const exh  = exhibitions.find(e => e.slug === 'cellular-impressions')!;
const tut  = tutorials.find(t => t.slug === exh.tutorialSlug);

function src(filename: string) {
  return `${base}exhibitions/cellular-impressions/${filename}`;
}
---
<Layout title={exh.title} description={exh.subtitle}>

  <section class="section-sm page-header">
    <div class="container narrow">
      <a href={`${base}exhibitions`} class="back">← Exhibitions</a>
      <p class="kicker">Math + Code + Art Initiative · UCLA Mathematics · {exh.year}</p>
      <h1>{exh.title}</h1>
      <p class="subtitle">{exh.subtitle}</p>
      <p class="artists">{exh.artists.join(', ')}</p>
    </div>
  </section>

  <!-- Artist Statement -->
  <section class="section statement-section">
    <div class="container narrow">
      <p class="label">Artist Statement</p>
      <div class="statement">
        {exh.statement.map(para => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Works -->
  <section class="section works-section">
    <div class="container narrow">
      <p class="label">Works</p>
      <div class="works-list">
        {exh.works.map(work => (
          <div class="work">
            <div class="work-image img-box">
              <img src={src(work.src)} alt={work.title} loading="lazy" />
            </div>
            <div class="work-meta">
              <div class="work-info">
                <h2 class="work-title">{work.title}</h2>
                <p class="work-year">{work.year}</p>
                <p class="work-medium">{exh.medium}</p>
              </div>
              {(work.portraitSrc || work.styleSrc) && (
                <div class="work-sources">
                  {work.portraitSrc && (
                    <div class="source-thumb">
                      <img src={src(work.portraitSrc)} alt="Portrait" loading="lazy" />
                      <span>Portrait</span>
                    </div>
                  )}
                  {work.styleSrc && (
                    <div class="source-thumb">
                      <img src={src(work.styleSrc)} alt="Style" loading="lazy" />
                      <span>Style</span>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tutorial callout -->
  {tut && (
    <section class="section callout-section">
      <div class="container narrow">
        <a href={`${base}tutorials/${tut.slug}`} class="callout">
          <div>
            <p class="callout-label">Tutorial</p>
            <p class="callout-title">{tut.title}</p>
            <p class="callout-desc">{tut.tagline}</p>
          </div>
          <span class="callout-arrow">→</span>
        </a>
      </div>
    </section>
  )}

  <!-- Lightbox -->
  <div id="lightbox" aria-hidden="true">
    <button id="lb-close" aria-label="Close">✕</button>
    <img id="lb-img" src="" alt="" />
  </div>

</Layout>

<style>
/* ── Exhibition Catalogue aesthetic — dark warm sepia ── */
/* No dot-grid. Warm dark ground, parchment text, gold accent. */
:global(body) {
  background-color: #faf6ec;
  background-image: none;
  color: #2a2118;
}
:global(.nav-wrap) {
  background: rgba(250,246,236,0.88) !important;
  border-bottom-color: #e5dcc8 !important;
}
:global(.nav-logo-text) { color: #2a2118 !important; }
:global(.nav-links a)   { color: #7a6a52 !important; }
:global(.nav-links a:hover) { color: #2a2118 !important; background: rgba(0,0,0,0.04) !important; border-color: #e5dcc8 !important; }
:global(.footer) { border-top-color: #e5dcc8 !important; background: #f2ecdc !important; }
:global(.footer-name, .footer-sub, .footer-links a) { color: #7a6a52 !important; }
:global(.footer-links a:hover) { color: #8a6d2f !important; background: transparent !important; }

/* Catalogue variables for this page */
--cat-bg:     #faf6ec;
--cat-ink:    #2a2118;
--cat-muted:  #7a6a52;
--cat-border: #e5dcc8;
--cat-accent: #8a6d2f;

.narrow { max-width: 820px; }

/* Header */
.page-header {
  border-bottom: 1px solid var(--cat-border);
  padding-bottom: 3rem;
}
.back {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cat-muted);
  margin-bottom: 1.75rem;
  transition: color 0.15s;
  letter-spacing: 0.03em;
}
.back:hover { color: var(--cat-ink); }
.kicker {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--cat-muted);
  margin-bottom: 1.1rem;
}
h1 {
  font-family: var(--font-serif) !important;
  font-size: clamp(2rem, 5vw, 3.2rem) !important;
  font-weight: 400 !important;
  letter-spacing: -0.01em !important;
  color: var(--cat-ink) !important;
  line-height: 1.15 !important;
  margin-bottom: 0.75rem;
}
.subtitle {
  font-size: 1.05rem;
  color: var(--cat-muted);
  font-style: italic;
  font-weight: 400;
  margin-bottom: 0.6rem;
}
.artists {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cat-muted);
  letter-spacing: 0.04em;
}

/* Section labels */
.label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cat-muted);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--cat-border);
}

/* Statement */
.statement-section { padding-bottom: 0; }
.statement { display: flex; flex-direction: column; gap: 1.25rem; max-width: 640px; }
.statement p {
  font-size: 1rem;
  line-height: 1.9;
  color: var(--cat-ink);
  font-weight: 300;
}

/* Works */
.works-section { border-top: 1px solid var(--cat-border); }
.works-list { display: flex; flex-direction: column; gap: 5rem; }

.work {
  display: grid;
  grid-template-columns: 1fr 200px;
  gap: 2.5rem;
  align-items: start;
}
@media (max-width: 640px) {
  .work { grid-template-columns: 1fr; }
}

.work-image {
  border-radius: 2px;
  overflow: hidden;
  border: 1px solid var(--cat-border);
  background: #f0e9d8;
  aspect-ratio: 4 / 3;
  cursor: zoom-in;
}
.work-image img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s var(--ease-out), opacity 0.3s ease;
}
.work:hover .work-image img { transform: scale(1.02); opacity: 0.94; }

.work-meta {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  padding-top: 0.25rem;
}
.work-title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 400;
  color: var(--cat-ink);
  margin-bottom: 0.3rem;
  line-height: 1.3;
}
.work-year {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cat-muted);
  margin-bottom: 0.6rem;
  letter-spacing: 0.04em;
}
.work-medium {
  font-size: 0.82rem;
  color: var(--cat-muted);
  line-height: 1.65;
  font-style: italic;
}

.work-sources {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--cat-border);
}
.source-thumb { display: flex; flex-direction: column; gap: 0.3rem; }
.source-thumb img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 2px;
  border: 1px solid var(--cat-border);
  display: block;
}
.source-thumb span {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--cat-muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* Callout */
.callout-section { border-top: 1px solid var(--cat-border); padding-bottom: 5rem; }
.callout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: #f2ecdc;
  border: 1px solid var(--cat-border);
  border-radius: 2px;
  padding: 1.5rem 2rem;
  transition: border-color 0.15s;
}
.callout:hover { border-color: var(--cat-accent); }
.callout-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--cat-muted);
  margin-bottom: 0.4rem;
}
.callout-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 400;
  color: var(--cat-ink);
  margin-bottom: 0.2rem;
}
.callout-desc { font-size: 0.83rem; color: var(--cat-muted); }
.callout-arrow {
  font-size: 1.2rem;
  color: var(--cat-accent);
  transition: transform 0.15s;
  flex-shrink: 0;
}
.callout:hover .callout-arrow { transform: translateX(4px); }

/* Lightbox */
#lightbox {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(10,8,5,0.92);
  display: flex; align-items: center; justify-content: center;
  padding: 2rem;
  opacity: 0; pointer-events: none;
  transition: opacity 0.2s ease;
}
#lightbox.open { opacity: 1; pointer-events: all; }
#lb-img {
  max-width: 100%; max-height: 90vh;
  object-fit: contain;
  border-radius: 2px;
  box-shadow: 0 8px 60px rgba(0,0,0,0.7);
  transform: scale(0.96);
  transition: transform 0.2s ease;
}
#lightbox.open #lb-img { transform: scale(1); }
#lb-close {
  position: absolute; top: 1.25rem; right: 1.5rem;
  background: none; border: none;
  color: rgba(255,255,255,0.5); font-size: 1.4rem;
  cursor: pointer; line-height: 1;
  transition: color 0.15s;
}
#lb-close:hover { color: #fff; }
</style>

<script>
const lb    = document.getElementById('lightbox')!;
const lbImg = document.getElementById('lb-img') as HTMLImageElement;

function openLightbox(src: string, alt: string) {
  lbImg.src = src; lbImg.alt = alt;
  lb.classList.add('open');
  lb.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  lb.classList.remove('open');
  lb.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

document.querySelectorAll<HTMLElement>('.img-box').forEach(box => {
  box.addEventListener('click', () => {
    const img = box.querySelector('img')!;
    openLightbox(img.src, img.alt);
  });
});

document.getElementById('lb-close')!.addEventListener('click', closeLightbox);
lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
