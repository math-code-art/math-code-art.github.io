---
import Layout from '../layouts/Layout.astro';
import TutorialCard from '../components/TutorialCard.astro';
import { tutorials } from '../data/tutorials';
import { news } from '../data/news';
const base = import.meta.env.BASE_URL;
const latestNews = news.slice(0, 3);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const typeColors: Record<string, string> = {
  Talk: 'tag-talk', Exhibition: 'tag-exhibition',
  Publication: 'tag-publication', 'New Tutorial': 'tag-tutorial',
};
---
<Layout title="Home">

  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content fade-up">
          <p class="hero-kicker"><span class="kicker-dot"></span>UCLA Mathematics Initiative</p>
          <h1>Math<span class="grad">+</span>Code<span class="grad">+</span>Art</h1>
          <p class="hero-desc">
            An open initiative connecting mathematical ideas to visual and audio output —
            through tutorials, exhibitions, and research.
          </p>
          <div class="hero-btns">
            <a href={`${base}tutorials`} class="btn btn-primary">Browse tutorials</a>
            <a href={`${base}about`} class="btn btn-ghost">About the initiative</a>
          </div>
          <div class="hero-pillars">
            <span class="pillar">Education</span>
            <span class="pillar-sep">·</span>
            <span class="pillar">Creation</span>
            <span class="pillar-sep">·</span>
            <span class="pillar">Exploration</span>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <svg class="hero-svg" viewBox="0 0 340 340" xmlns="http://www.w3.org/2000/svg">
            <!-- Voronoi-inspired radial lines -->
            <g stroke="rgba(15,118,110,0.22)" stroke-width="0.5" fill="none">
              {Array.from({length: 24}, (_, i) => {
                const angle = (i / 24) * Math.PI * 2;
                const x2 = 170 + Math.cos(angle) * 155;
                const y2 = 170 + Math.sin(angle) * 155;
                return `<line x1="170" y1="170" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" />`;
              }).join('')}
            </g>
            <!-- Spirograph parametric curves -->
            <path class="spiro-1" fill="none" stroke="rgba(15,118,110,0.6)" stroke-width="1.2"
              d={`M ${Array.from({length: 360}, (_, t) => {
                const R=110, r=37, d=60, rad=t*Math.PI/180;
                const x = 170 + (R-r)*Math.cos(rad) + d*Math.cos((R-r)/r*rad);
                const y = 170 + (R-r)*Math.sin(rad) - d*Math.sin((R-r)/r*rad);
                return `${t===0?'':' L'}${x.toFixed(2)} ${y.toFixed(2)}`;
              }).join('')} Z`}
            />
            <path class="spiro-2" fill="none" stroke="rgba(180,83,9,0.45)" stroke-width="0.8"
              d={`M ${Array.from({length: 360}, (_, t) => {
                const R=90, r=23, d=75, rad=t*Math.PI/180;
                const x = 170 + (R-r)*Math.cos(rad) + d*Math.cos((R-r)/r*rad);
                const y = 170 + (R-r)*Math.sin(rad) - d*Math.sin((R-r)/r*rad);
                return `${t===0?'':' L'}${x.toFixed(2)} ${y.toFixed(2)}`;
              }).join('')} Z`}
            />
            <!-- Center dot -->
            <circle cx="170" cy="170" r="3" fill="var(--accent)" opacity="0.8"/>
            <!-- Orbit rings -->
            <circle cx="170" cy="170" r="115" stroke="rgba(15,118,110,0.16)" stroke-width="1" fill="none"/>
            <circle cx="170" cy="170" r="75" stroke="rgba(180,83,9,0.14)" stroke-width="1" fill="none"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  {latestNews.length > 0 && (
    <section class="news-strip">
      <div class="container">
        <div class="news-row">
          <span class="news-heading">// latest</span>
          {latestNews.map(item => (
            <a href={item.link ?? `${base}news`} class="news-pill" {...(item.link?.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class={`tag tag-sm ${typeColors[item.type] ?? ''}`}>{item.type}</span>
              <span class="news-pill-title">{item.title}</span>
              <span class="news-pill-date">{formatDate(item.date)}</span>
            </a>
          ))}
          <a href={`${base}news`} class="news-all">All news →</a>
        </div>
      </div>
    </section>
  )}

  <section class="section tutorials-section" style="padding-top: 1.5rem">
    <div class="container">
      <p class="section-label">// tutorials</p>
      <div class="grid-2">
        {tutorials.map((t, i) => (
          <TutorialCard
            tutorial={t}
            index={i}
            href={`${base}tutorials/${t.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Hero ── */
.hero {
  padding: 5rem 0 4rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 0;
  position: relative;
  overflow: hidden;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 3rem;
}

.hero-kicker {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 1.1rem;
}
.kicker-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--accent); }
  50% { opacity: 0.5; box-shadow: 0 0 3px var(--accent); }
}

.hero h1 {
  font-size: clamp(2.2rem, 6vw, 3.6rem);
  margin-bottom: 1.2rem;
}

.hero-desc {
  max-width: 480px;
  font-size: 1rem;
  line-height: 1.75;
  color: var(--muted);
  margin-bottom: 2rem;
}

.hero-btns {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}

.hero-pillars {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.04em;
}
.pillar { color: var(--accent); }
.pillar-sep { color: var(--border-2); }

/* SVG visual */
.hero-visual {
  flex-shrink: 0;
}
.hero-svg {
  width: 280px;
  height: 280px;
  opacity: 0.9;
}
.spiro-1 {
  animation: spin-slow 40s linear infinite;
  transform-origin: 170px 170px;
}
.spiro-2 {
  animation: spin-slow 60s linear infinite reverse;
  transform-origin: 170px 170px;
}
@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@media (max-width: 700px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
}

/* ── News strip ── */
.news-strip {
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  padding: 0;
}
.news-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  padding: 0.8rem 0;
}
.news-heading {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--accent);
  margin-right: 0.25rem;
  flex-shrink: 0;
}
.news-pill {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 4px;
  padding: 0.28rem 0.7rem 0.28rem 0.4rem;
  transition: border-color var(--dur-fast), background var(--dur-fast);
}
.news-pill:hover {
  border-color: rgba(15,118,110,0.35);
  background: var(--bg);
}
.tag-sm { font-size: 0.6rem; padding: 1px 6px; }
.news-pill-title {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text);
  font-weight: 400;
}
.news-pill-date {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--muted);
}
.news-all {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--muted);
  margin-left: auto;
  transition: color var(--dur-fast);
  flex-shrink: 0;
}
.news-all:hover { color: var(--accent); }

.tag-talk        { background: rgba(15,118,110,0.1);  color: #0f766e; border-color: rgba(15,118,110,0.28); }
.tag-exhibition  { background: rgba(180,83,9,0.1);    color: #b45309; border-color: rgba(180,83,9,0.28); }
.tag-publication { background: rgba(67,56,202,0.1);   color: #4338ca; border-color: rgba(67,56,202,0.28); }
.tag-tutorial    { background: rgba(161,98,7,0.1);    color: #a16207; border-color: rgba(161,98,7,0.28); }

/* ── Tutorials section ── */
.tutorials-section {}
</style>
