---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Tutorials on mathematics, programming, and visual art — UCLA Mathematics.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <title>{title === 'Home' ? 'Math + Code + Art' : `${title} — Math + Code + Art`}</title>
</head>
<body>
  <header class="nav-wrap">
    <nav class="container nav-inner">
      <a href={base} class="nav-logo">
        <span class="nav-logo-bracket grad">[</span>
        <span class="nav-logo-text">Math+Code+Art</span>
        <span class="nav-logo-bracket grad">]</span>
      </a>
      <ul class="nav-links">
        <li><a href={`${base}about`}>About</a></li>
        <li><a href={`${base}tutorials`}>Tutorials</a></li>
        <li><a href={`${base}exhibitions`}>Exhibitions</a></li>
        <li><a href={`${base}research`}>Research</a></li>
        <li><a href={`${base}news`}>News</a></li>
        <li><a href={`${base}team`}>Team</a></li>
      </ul>
      <button class="nav-toggle" aria-label="Open menu" onclick="this.closest('nav').classList.toggle('open')">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <main><slot /></main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="grad footer-name">Math+Code+Art</span>
        <span class="footer-sub">UCLA Mathematics · Education · Creation · Exploration</span>
      </div>
      <ul class="footer-links">
        <li><a href={`${base}about`}>About</a></li>
        <li><a href={`${base}tutorials`}>Tutorials</a></li>
        <li><a href={`${base}exhibitions`}>Exhibitions</a></li>
        <li><a href={`${base}research`}>Research</a></li>
        <li><a href={`${base}news`}>News</a></li>
        <li><a href={`${base}team`}>Team</a></li>
        <li><a href="https://github.com/jiayinlu19960224/Math-Code-Art" target="_blank" rel="noopener">GitHub ↗</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>

<style>
/* ── Nav ── */
.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--nav-h);
  background: rgba(6,6,8,0.82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

/* Logo — monospace bracket style */
.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.1em;
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  text-decoration: none;
}
.nav-logo-bracket {
  font-size: 1.15em;
  line-height: 1;
  opacity: 0.9;
}
.nav-logo-text {
  color: var(--text);
  padding: 0 0.15em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.nav-links a {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--muted);
  padding: 0.3rem 0.65rem;
  border-radius: 4px;
  border: 1px solid transparent;
  transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  letter-spacing: 0.01em;
}
.nav-links a:hover {
  color: var(--accent);
  border-color: var(--border-2);
  background: var(--surface);
}

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
}
.nav-toggle span {
  display: block;
  width: 20px;
  height: 1.5px;
  background: var(--muted);
  border-radius: 2px;
  transition: background var(--dur-fast);
}
.nav-toggle:hover span { background: var(--accent); }

@media (max-width: 600px) {
  .nav-toggle { display: flex; }
  .nav-links {
    display: none;
    position: absolute;
    top: var(--nav-h);
    left: 0; right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem 1.5rem;
    gap: 0.25rem;
  }
  .nav-links a { width: 100%; border-color: transparent !important; }
  nav.open .nav-links { display: flex; }
}

/* ── Footer ── */
.footer {
  border-top: 1px solid var(--border);
  padding: 2.5rem 0;
  margin-top: 5rem;
}
.footer-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.footer-name {
  font-family: var(--font-mono);
  font-weight: 600;
  font-size: 0.9rem;
}
.footer-sub {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--muted);
  letter-spacing: 0.03em;
}
.footer-links {
  display: flex;
  gap: 0.25rem;
  flex-wrap: wrap;
  align-items: center;
}
.footer-links a {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--muted);
  padding: 0.2rem 0.5rem;
  border-radius: 3px;
  transition: color var(--dur-fast), background var(--dur-fast);
}
.footer-links a:hover { color: var(--accent); background: var(--surface); }

@media (max-width: 600px) {
  .footer-inner { flex-direction: column; gap: 1.25rem; }
  .footer-links { margin-left: 0; }
}
</style>
