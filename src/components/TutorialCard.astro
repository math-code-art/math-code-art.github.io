---
import type { Tutorial } from '../data/tutorials';

interface Props {
  tutorial: Tutorial;
  index: number;
  href: string;
  showDescription?: boolean;
}

const { tutorial: t, index, href, showDescription = false } = Astro.props;
const base = import.meta.env.BASE_URL;

function resolveSrc(src: string) {
  if (src.startsWith('local:')) return `${base}gallery/${src.slice(6)}`;
  return src;
}

const firstItem = t.gallery[0] ?? null;
const previewSrc = firstItem ? resolveSrc(firstItem.src) : null;
const previewKind = firstItem?.kind ?? 'image';
const numLabel = String(index + 1).padStart(2, '0');
---

<a href={href} class={`card tut-card${previewSrc ? ' has-preview' : ''}`}>
  {previewSrc && (
    <div class="tut-preview">
      {previewKind === 'video'
        ? <video src={previewSrc} muted loop playsinline autoplay class="preview-media" />
        : <img src={previewSrc} alt={t.title} class="preview-media" loading="lazy" />
      }
      <span class="tut-num-overlay">{numLabel}</span>
    </div>
  )}
  <div class="tut-body">
    <div class="tut-top">
      {!previewSrc && <span class="tut-num-inline">{numLabel}</span>}
      <div class="tut-tags">
        {t.tags.slice(0, 2).map(tag => <span class="tag">{tag}</span>)}
      </div>
    </div>
    <h3 class="tut-title">{t.title}</h3>
    <p class="tut-tagline">{t.tagline}</p>
    {showDescription && <p class="tut-desc">{t.description}</p>}
    <div class="tut-footer">
      <span class="tut-lead">{t.leads.join(', ')}</span>
      <span class="arrow">→</span>
    </div>
  </div>
</a>

<style>
.tut-card {
  display: flex;
  flex-direction: column;
  padding: 0;
  cursor: pointer;
  overflow: hidden;
  text-decoration: none;
}

/* Preview image / video */
.tut-preview {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--surface-2);
  flex-shrink: 0;
  position: relative;
}
.preview-media {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s var(--ease-out);
  filter: saturate(0.85);
}
.tut-card:hover .preview-media {
  transform: scale(1.05);
  filter: saturate(1.1);
}

/* Mono number overlaid on image */
.tut-num-overlay {
  position: absolute;
  bottom: 0.6rem;
  left: 0.75rem;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  color: rgba(255,255,255,0.55);
  letter-spacing: 0.06em;
  background: rgba(6,6,8,0.55);
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  backdrop-filter: blur(4px);
}

/* Card body */
.tut-body {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  padding: 1.1rem 1.25rem 1.3rem;
  flex: 1;
}

.tut-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.15rem;
}
.tut-num-inline {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 500;
  color: var(--faint);
  letter-spacing: 0.06em;
}
.tut-tags { display: flex; gap: 0.3rem; }

.tut-title {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text);
  letter-spacing: -0.01em;
  line-height: 1.3;
}

.tut-tagline {
  font-size: 0.8rem;
  color: var(--accent);
  font-weight: 400;
  line-height: 1.5;
  font-family: var(--font-body);
}

.tut-desc {
  font-size: 0.83rem;
  color: var(--muted);
  line-height: 1.6;
  flex: 1;
  margin-top: 0.15rem;
}

.tut-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 0.7rem;
  border-top: 1px solid var(--border);
}
.tut-lead {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--muted);
  letter-spacing: 0.01em;
}
.arrow {
  font-family: var(--font-mono);
  color: var(--accent);
  font-size: 0.9rem;
  transition: transform var(--dur-fast) var(--ease-out);
  opacity: 0.7;
}
.tut-card:hover .arrow {
  transform: translateX(4px);
  opacity: 1;
}
</style>
